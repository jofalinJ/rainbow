{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rainbow-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "20261021",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {
    "enabled": true
  }
}
