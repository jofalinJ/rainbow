{
  "name": "jj-gold-covering",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/run-e2e-local.mjs",
    "test:e2e:public": "node --test tests/e2e/selenium/tests/public.test.mjs",
    "test:e2e:authenticated": "node --test tests/e2e/selenium/tests/staff.test.mjs",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "npm run build:biometric && node scripts/verify-static.mjs",
    "security": "npm audit --audit-level=high",
    "build:biometric": "node scripts/build-biometric.mjs",
    "test:database": "node --test tests/database/biometric.test.mjs",
    "test:self-hosted-contract": "node --test tests/contract/selfHostedContract.test.mjs",
    "check:biometric": "node scripts/check-biometric.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-rekognition": "3.1148.0",
    "@aws-sdk/client-sts": "3.1148.0",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^9.39.1",
    "@supabase/supabase-js": "^2.58.0",
    "@vitest/coverage-v8": "5.0.3",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "selenium-webdriver": "^4.38.0",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "vite": "^7.3.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.15.7",
    "@aws-amplify/ui-react-liveness": "3.7.0",
    "aws-amplify": "6.22.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
